{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "functions": {
    "api/analyze.ts": {
      "maxDuration": 60
    },
    "api/chat.ts": {
      "maxDuration": 30
    }
  }
}
